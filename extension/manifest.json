{
    "name": "E2A Tool",
    "manifest_version": 3,
    "version": "2.0.0",
    "version_name": "2.0.0",
    "description": "E2A Tool is a task counter and time tracker for Arrow Rater (raters) working for Appen on the Ewoq Rating Portal.",
    "action": {
        "default_popup": "./pages/popup.html"
    },
    "icons": {
        "16": "./assets/icons/16x16/icon-black.png",
        "32": "./assets/icons/32x32/icon-black.png",
        "48": "./assets/icons/48x48/icon-black.png",
        "128": "./assets/icons/128x128/icon-black.png"
    },
    "permissions": [
        "contextMenus",
        "storage",
        "unlimitedStorage",
        "notifications",
        "identity",
        "identity.email",
        "tabs"
    ],
    "background": {
        "service_worker": "./scripts/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "http://127.0.0.1:5500/test.html"
            ],
            "css": [
                "./assets/css/style_ewoq.css"
            ],
            "js": [
                "./scripts/script_for_ewoq.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "res/noti-audio/*",
                "assets/images/*"
            ],
            "matches": [
                "http://127.0.0.1:5500/*"
            ]
        }
    ]
}