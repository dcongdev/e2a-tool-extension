{
    "name": "E2A Tool",
    "manifest_version": 3,
    "version": "0.1.0.0",
    "version_name": "1.0 Beta",
    "description": "This extension helps Arrow Rater to calculate the number of submitted tasks on the evaluation platform Ewoq Rating Portal.",
    "action": {
        "default_popup": "./pages/popup.html"
    },
    "options_page": "./pages/popup.html",
    "icons": {
        "16": "./assets/icons/16x16/icon-black.png",
        "32": "./assets/icons/32x32/icon-black.png",
        "48": "./assets/icons/48x48/icon-black.png",
        "128": "./assets/icons/128x128/icon-black.png"
    },
    "permissions": [
        "contextMenus",
        "storage",
        "notifications",
        "identity",
        "identity.email"
    ],
    "background": {
        "service_worker": "./scripts/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://rating.ewoq.google.com/*"
            ],
            "css": [
                "./assets/css/style_ewoq.css"
            ],
            "js": [
                "./scripts/script_for_ewoq.js"
            ]
        }
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*",
        "*://*/*",
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "res/noti-audio/*",
                "assets/images/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}