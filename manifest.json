{
    "name": "E2A Tool",
    "manifest_version": 3,
    "version": "1.0.0.0",
    "version_name": "1.0 rc1",
    "description": "",
    "action": {
        "default_icon": "./assets/icons/auto-mode-icon.png"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "contextMenus",
        "storage",
        "tabs",
        "webNavigation",
        "notifications",
        "identity", 
        "identity.email"
    ],
    "background": {
        "service_worker": "./scripts/background.js"
    }
}