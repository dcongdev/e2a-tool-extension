{
    "name": "E2A Tool",
    "manifest_version": 3,
    "version": "0.0.0.1",
    "description": "This extension helps Arrow Rater to calculate the number of submitted tasks on the evaluation platform Ewoq Rating Portal.",
    "action": {
        "default_icon": "./assets/icons/the-avengers-icon.png"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "contextMenus",
        "storage",
        "tabs",
        "webNavigation",
        "notifications",
        "identity", 
        "identity.email"
    ],
    "background": {
        "service_worker": "./scripts/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://rating.ewoq.google.com/*"
            ],
            "js": [
                "./scripts/script_for_ewoq.js"
            ]
        }
    ]
}