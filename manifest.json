{
  "name": "E2A Tool - EWOQ time tracker and more...",
  "manifest_version": 3,
  "version": "3.2.0",
  "version_name": "3.2.0",
  "description": "E2A Tool is a task counter and time tracker for Arrow Project, PIAA project, ...",
  "action": { "default_popup": "./pages/popup.html" },
  "icons": {
    "16": "./assets/images/icons/16x16/icon-black.png",
    "32": "./assets/images/icons/32x32/icon-black.png",
    "48": "./assets/images/icons/48x48/icon-black.png",
    "128": "./assets/images/icons/128x128/icon-black.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "notifications",
    "identity",
    "identity.email",
    "tabs",
    "downloads",
    "scripting"
  ],
  "background": {
    "service_worker": "./background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://rating.ewoq.google.com/*"],
      "js": [
        "./utils/messaging.js",
        "./content/ui.js",
        "./content/observe.js",
        "./content/index.js"
      ]
    }
  ],
  "host_permissions": ["https://*/*", "http://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["assets/sounds/*", "assets/images/*"],
      "matches": ["https://rating.ewoq.google.com/*"]
    }
  ]
}
